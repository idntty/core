{
    "name": "idntty",
    "version": "0.1.0",
    "description": "idntty.io",
    "author": "idntty",
    "license": "MIT",
    "keywords": [
        "blockchain",
        "klayr",
        "nodejs",
        "javascript",
        "typescript"
    ],
    "homepage": "",
    "repository": {},
    "engines": {
        "node": ">=18.12.0 <=18",
        "npm": ">=8.1.0"
    },
    "main": "dist/index.js",
    "scripts": {
        "lint": "eslint --ext .ts .",
        "lint:fix": "eslint --fix --ext .js,.ts .",
        "format": "prettier --write '**/*'",
        "prepack": "oclif manifest && oclif readme --multi --dir=docs/commands && npm shrinkwrap && npm prune --production && npm shrinkwrap",
        "prebuild": "if test -d dist; then rm -r dist; fi; rm -f tsconfig.tsbuildinfo; rm -f npm-shrinkwrap.json",
        "start": "echo Run \"./bin/run start\" to start the app",
        "build": "tsc",
        "test": "jest --passWithNoTests",
        "test:coverage": "jest --passWithNoTests --coverage=true --coverage-reporters=text",
        "test:ci": "jest --passWithNoTests --coverage=true --coverage-reporters=json",
        "version": "oclif readme --multi --dir=docs/commands && git add README.md docs",
        "prepublishOnly": "npm ci && npm run lint && npm run build"
    },
    "bin": {
        "idntty": "./bin/run"
    },
    "klayr": {
        "addressPrefix": "kly"
    },
    "oclif": {
        "bin": "idntty",
        "commands": "./dist/commands",
        "plugins": [
            "@oclif/plugin-help",
            "@oclif/plugin-autocomplete",
            "@oclif/plugin-version"
        ],
        "additionalHelpFlags": [
            "-h"
        ],
        "additionalVersionFlags": [
            "-v"
        ],
        "topicSeparator": " ",
        "topics": {
            "block": {
                "description": "Commands relating to idntty blocks."
            },
            "blockchain": {
                "description": "Commands relating to idntty blockchain data."
            },
            "console": {
                "description": "idntty interactive REPL session to run commands."
            },
            "config": {
                "description": "Commands relating to idntty node configuration."
            },
            "keys": {
                "description": "Commands relating to idntty key generation."
            },
            "generator": {
                "description": "Commands relating to idntty block generator."
            },
            "hash-onion": {
                "description": "Create hash onions to be used by the forger."
            },
            "system": {
                "description": "Commands relating to idntty node."
            },
            "passphrase": {
                "description": "Commands relating to idntty passphrases."
            },
            "endpoint": {
                "description": "Commands relating to idntty endpoint."
            },
            "sdk": {
                "description": "Commands relating to Lisk SDK development."
            },
            "transaction": {
                "description": "Commands relating to idntty transactions."
            }
        }
    },
    "files": [
        "/bin",
        "/npm-shrinkwrap.json",
        "/oclif.manifest.json",
        "/dist",
        "/config",
        "/docs"
    ],
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.554.0",
        "@aws-sdk/s3-request-presigner": "^3.554.0",
        "@digitalbazaar/data-integrity": "^2.5.0",
        "@digitalbazaar/ed25519-multikey": "^1.3.1",
        "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "^1.2.0",
        "@digitalbazaar/security-document-loader": "^3.0.1",
        "@digitalcredentials/jsonld-signatures": "^12.0.1",
        "@digitalcredentials/open-badges-context": "^2.1.0",
        "@digitalcredentials/security-document-loader": "^7.0.0",
        "@fastify/cors": "^9.0.1",
        "@klayr/chain-connector-plugin": "0.2.2",
        "@klayr/dashboard-plugin": "^0.4.2",
        "@klayr/faucet-plugin": "0.4.2",
        "@klayr/generator-plugin": "0.5.2",
        "@klayr/monitor-plugin": "0.5.2",
        "@klayr/report-misbehavior-plugin": "0.5.2",
        "@oclif/core": "1.20.4",
        "@oclif/plugin-autocomplete": "1.3.6",
        "@oclif/plugin-help": "5.1.19",
        "@oclif/plugin-version": "1.1.3",
        "@prisma/client": "^6.9.0",
        "@simplewebauthn/server": "^9.0.3",
        "apify-client": "^2.10.0",
        "axios": "0.21.2",
        "base58-universal": "^2.0.0",
        "date-fns": "^3.6.0",
        "fastify": "^4.26.2",
        "fs-extra": "11.1.0",
        "inquirer": "8.2.5",
        "jose": "^5.3.0",
        "jsonld-signatures": "^11.5.0",
        "klayr-commander": "6.1.2",
        "klayr-sdk": "6.1.3",
        "libsodium-wrappers-sumo": "^0.7.15",
        "multibase": "^4.0.6",
        "pg": "^8.11.3",
        "postgres": "^3.4.4",
        "tar": "6.1.11",
        "tslib": "2.4.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@klayr/api-client": "^6.1.2",
        "@oclif/test": "2.2.12",
        "@simplewebauthn/types": "^10.0.0",
        "@types/fs-extra": "9.0.13",
        "@types/jest": "29.2.3",
        "@types/jest-when": "3.5.2",
        "@types/libsodium-wrappers-sumo": "^0.7.8",
        "@types/node": "18.15.3",
        "@types/tar": "6.1.3",
        "@typescript-eslint/eslint-plugin": "5.44.0",
        "@typescript-eslint/parser": "5.44.0",
        "eslint": "8.28.0",
        "eslint-config-klayr-base": "2.0.1",
        "eslint-plugin-import": "2.26.0",
        "eslint-plugin-jest": "27.1.6",
        "globby": "10.0.2",
        "husky": "4.2.5",
        "jest": "29.3.1",
        "jest-extended": "3.2.0",
        "jest-when": "3.5.2",
        "lint-staged": "10.2.11",
        "oclif": "3.2.31",
        "prettier": "2.8.0",
        "prisma": "^6.9.0",
        "ts-jest": "29.0.3",
        "ts-node": "10.9.1",
        "typescript": "5.0.2"
    }
}
