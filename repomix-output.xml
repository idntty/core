    isAuthority,
    credentialID,
    credentialPublicKey,
    counter,
    transports,
    layout,
}: {
    publicKey: string;
    username: string;
    isAuthority: boolean;
    credentialID: Uint8Array;
    credentialPublicKey: Uint8Array;
    counter: number;
